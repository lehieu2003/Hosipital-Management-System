generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
}

enum PatientGender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InpatientAdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum BedMovementType {
  ASSIGNED
  TRANSFERRED
  DISCHARGED
}

enum BillingPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID_IN_FULL
}

enum BillingSettlementStatus {
  OPEN
  PENDING_SETTLEMENT
  SETTLED
}

enum BillingInvoiceLineType {
  CHARGE
}

enum BillingTransitionType {
  INVOICE_OPENED
  CHARGE_APPENDED
  PAYMENT_RECORDED
  DISCHARGE_SYNC
  SETTLEMENT_COMPLETED
}

model User {
  id                           String                 @id @default(cuid())
  username                     String                 @unique
  passwordHash                 String                 @map("password_hash")
  role                         UserRole
  isActive                     Boolean                @default(true) @map("is_active")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")
  refreshTokens                RefreshSession[]
  registeredPatients           Patient[]              @relation("RegisteredPatients")
  doctorAppointments           Appointment[]          @relation("DoctorAppointments")
  assignedDepartment           Department?            @relation("AssignedDepartmentDoctor")
  admittedInpatientAdmissions  InpatientAdmission[]   @relation("AdmittedByUser")
  dischargedInpatientAdmissions InpatientAdmission[]  @relation("DischargedByUser")
  attendingInpatientAdmissions InpatientAdmission[]   @relation("AttendingDoctorAdmissions")
  managedBedOccupancies         BedOccupancy[]              @relation("BedOccupancyManagedByUser")
  inpatientBedMovements         InpatientBedMovement[]      @relation("BedMovementPerformedByUser")
  createdBillingInvoices        BillingInvoice[]            @relation("BillingInvoiceCreatedByUser")
  createdBillingInvoiceLines    BillingInvoiceLine[]        @relation("BillingInvoiceLineCreatedByUser")
  recordedBillingPayments       BillingPayment[]            @relation("BillingPaymentRecordedByUser")
  recordedBillingTransitions    BillingTransitionHistory[]  @relation("BillingTransitionActorUser")
  createdBillingChargeReplays   BillingChargeIdempotency[]  @relation("BillingChargeReplayCreatedByUser")

  @@map("users")
  @@index([username], map: "idx_users_username")
}

model RefreshSession {
  id            String    @id @default(cuid())
  tokenJti      String    @unique @map("token_jti")
  tokenHash     String    @map("token_hash")
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?   @map("revoke_reason")
  replacedByJti String?   @map("replaced_by_jti")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("refresh_sessions")
  @@index([userId], map: "idx_refresh_sessions_user_id")
  @@index([expiresAt], map: "idx_refresh_sessions_expires_at")
}

model Department {
  id                   String    @id @default(cuid())
  name                 String    @unique
  assignedDoctorUserId String?   @unique @map("assigned_doctor_user_id")
  assignedDoctor       User?     @relation("AssignedDepartmentDoctor", fields: [assignedDoctorUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("departments")
  @@index([name], map: "idx_departments_name")
  @@index([assignedDoctorUserId], map: "idx_departments_assigned_doctor_user_id")
}

model Patient {
  id                 String               @id @default(cuid())
  registrationNumber String               @unique @default(cuid()) @map("registration_number")
  fullName           String               @map("full_name")
  primaryPhone       String               @map("primary_phone")
  email              String?
  dateOfBirth        DateTime?            @map("date_of_birth")
  gender             PatientGender?
  address            String?
  createdByUserId    String               @map("created_by_user_id")
  createdByUser      User                 @relation("RegisteredPatients", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  appointments       Appointment[]
  inpatientAdmissions InpatientAdmission[]
  billingInvoices    BillingInvoice[]

  @@map("patients")
  @@index([fullName], map: "idx_patients_full_name")
  @@index([createdByUserId], map: "idx_patients_created_by_user_id")
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorUserId    String            @map("doctor_user_id")
  doctor          User              @relation("DoctorAppointments", fields: [doctorUserId], references: [id], onDelete: Restrict)
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(30) @map("duration_minutes")
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("appointments")
  @@index([patientId], map: "idx_appointments_patient_id")
  @@index([doctorUserId, scheduledAt], map: "idx_appointments_doctor_scheduled_at")
}

model InpatientAdmission {
  id                  String                   @id @default(cuid())
  patientId           String                   @map("patient_id")
  patient             Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status              InpatientAdmissionStatus @default(ADMITTED)
  attendingDoctorUserId String?                @map("attending_doctor_user_id")
  attendingDoctor     User?                    @relation("AttendingDoctorAdmissions", fields: [attendingDoctorUserId], references: [id], onDelete: SetNull)
  admittedByUserId    String                   @map("admitted_by_user_id")
  admittedByUser      User                     @relation("AdmittedByUser", fields: [admittedByUserId], references: [id], onDelete: Restrict)
  admittedAt          DateTime                 @default(now()) @map("admitted_at")
  dischargeAt         DateTime?                @map("discharged_at")
  dischargeNotes      String?                  @map("discharge_notes")
  dischargedByUserId  String?                  @map("discharged_by_user_id")
  dischargedByUser    User?                    @relation("DischargedByUser", fields: [dischargedByUserId], references: [id], onDelete: SetNull)
  notes               String?
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  currentBedOccupancy BedOccupancy?            @relation("AdmissionCurrentBedOccupancy")
  bedMovements        InpatientBedMovement[]
  billingInvoice      BillingInvoice?

  @@map("inpatient_admissions")
  @@index([patientId], map: "idx_inpatient_admissions_patient_id")
  @@index([status, admittedAt], map: "idx_inpatient_admissions_status_admitted_at")
  @@index([attendingDoctorUserId], map: "idx_inpatient_admissions_attending_doctor_user_id")
  @@index([admittedByUserId], map: "idx_inpatient_admissions_admitted_by_user_id")
  @@index([dischargedByUserId], map: "idx_inpatient_admissions_discharged_by_user_id")
}

model Bed {
  id              String                @id @default(cuid())
  bedNumber       String                @unique @map("bed_number")
  wardName        String                @map("ward_name")
  roomNumber      String?               @map("room_number")
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  currentOccupancy BedOccupancy?        @relation("BedCurrentOccupancy")
  movementFrom    InpatientBedMovement[] @relation("MovementFromBed")
  movementTo      InpatientBedMovement[] @relation("MovementToBed")

  @@map("beds")
  @@index([wardName, roomNumber], map: "idx_beds_ward_room")
  @@index([isActive], map: "idx_beds_is_active")
}

model BedOccupancy {
  id               String             @id @default(cuid())
  admissionId      String             @unique @map("admission_id")
  admission        InpatientAdmission @relation("AdmissionCurrentBedOccupancy", fields: [admissionId], references: [id], onDelete: Cascade)
  bedId            String             @unique @map("bed_id")
  bed              Bed                @relation("BedCurrentOccupancy", fields: [bedId], references: [id], onDelete: Restrict)
  assignedByUserId String             @map("assigned_by_user_id")
  assignedByUser   User               @relation("BedOccupancyManagedByUser", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt       DateTime           @default(now()) @map("assigned_at")
  lastTransferredAt DateTime?         @map("last_transferred_at")
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("bed_occupancies")
  @@index([admissionId], map: "idx_bed_occupancies_admission_id")
  @@index([bedId], map: "idx_bed_occupancies_bed_id")
  @@index([assignedByUserId], map: "idx_bed_occupancies_assigned_by_user_id")
}

model InpatientBedMovement {
  id           String             @id @default(cuid())
  admissionId  String             @map("admission_id")
  admission    InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  movementType BedMovementType    @map("movement_type")
  fromBedId    String?            @map("from_bed_id")
  fromBed      Bed?               @relation("MovementFromBed", fields: [fromBedId], references: [id], onDelete: SetNull)
  toBedId      String?            @map("to_bed_id")
  toBed        Bed?               @relation("MovementToBed", fields: [toBedId], references: [id], onDelete: SetNull)
  movedByUserId String            @map("moved_by_user_id")
  movedByUser  User               @relation("BedMovementPerformedByUser", fields: [movedByUserId], references: [id], onDelete: Restrict)
  movedAt      DateTime           @default(now()) @map("moved_at")
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at")

  @@map("inpatient_bed_movements")
  @@index([admissionId, movedAt], map: "idx_inpatient_bed_movements_admission_moved_at")
  @@index([fromBedId], map: "idx_inpatient_bed_movements_from_bed_id")
  @@index([toBedId], map: "idx_inpatient_bed_movements_to_bed_id")
  @@index([movedByUserId], map: "idx_inpatient_bed_movements_moved_by_user_id")
}

model BillingInvoice {
  id               String                  @id @default(cuid())
  admissionId      String                  @unique @map("admission_id")
  admission        InpatientAdmission      @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId        String                  @map("patient_id")
  patient          Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  paymentStatus    BillingPaymentStatus    @default(UNPAID) @map("payment_status")
  settlementStatus BillingSettlementStatus @default(OPEN) @map("settlement_status")
  currency         String                  @default("USD")
  totalChargesMinor Int                    @default(0) @map("total_charges_minor")
  totalPaymentsMinor Int                   @default(0) @map("total_payments_minor")
  balanceMinor     Int                     @default(0) @map("balance_minor")
  dischargedAt     DateTime?               @map("discharged_at")
  settledAt        DateTime?               @map("settled_at")
  version          Int                     @default(1)
  createdByUserId  String?                 @map("created_by_user_id")
  createdByUser    User?                   @relation("BillingInvoiceCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  lines            BillingInvoiceLine[]
  payments         BillingPayment[]
  transitions      BillingTransitionHistory[]
  chargeReplays    BillingChargeIdempotency[]

  @@map("billing_invoices")
  @@index([patientId], map: "idx_billing_invoices_patient_id")
  @@index([paymentStatus, settlementStatus], map: "idx_billing_invoices_payment_settlement_status")
  @@index([createdByUserId], map: "idx_billing_invoices_created_by_user_id")
}

model BillingInvoiceLine {
  id              String                 @id @default(cuid())
  invoiceId       String                 @map("invoice_id")
  invoice         BillingInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineType        BillingInvoiceLineType @default(CHARGE) @map("line_type")
  chargeCode      String?                @map("charge_code")
  description     String
  quantity        Int                    @default(1)
  unitAmountMinor Int                    @map("unit_amount_minor")
  lineAmountMinor Int                    @map("line_amount_minor")
  metadata        Json?
  createdByUserId String?                @map("created_by_user_id")
  createdByUser   User?                  @relation("BillingInvoiceLineCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now()) @map("created_at")
  chargeReplay    BillingChargeIdempotency?

  @@map("billing_invoice_lines")
  @@index([invoiceId, createdAt], map: "idx_billing_invoice_lines_invoice_created_at")
  @@index([chargeCode], map: "idx_billing_invoice_lines_charge_code")
  @@index([createdByUserId], map: "idx_billing_invoice_lines_created_by_user_id")
}

model BillingPayment {
  id               String         @id @default(cuid())
  invoiceId        String         @map("invoice_id")
  invoice          BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinor      Int            @map("amount_minor")
  paymentMethod    String         @map("payment_method")
  paymentReference String?        @map("payment_reference")
  note             String?
  recordedByUserId String?        @map("recorded_by_user_id")
  recordedByUser   User?          @relation("BillingPaymentRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  receivedAt       DateTime       @default(now()) @map("received_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("billing_payments")
  @@index([invoiceId, receivedAt], map: "idx_billing_payments_invoice_received_at")
  @@index([recordedByUserId], map: "idx_billing_payments_recorded_by_user_id")
}

model BillingTransitionHistory {
  id                   String                  @id @default(cuid())
  invoiceId            String                  @map("invoice_id")
  invoice              BillingInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transitionType       BillingTransitionType   @map("transition_type")
  fromPaymentStatus    BillingPaymentStatus?   @map("from_payment_status")
  toPaymentStatus      BillingPaymentStatus    @map("to_payment_status")
  fromSettlementStatus BillingSettlementStatus? @map("from_settlement_status")
  toSettlementStatus   BillingSettlementStatus @map("to_settlement_status")
  balanceMinor         Int                     @map("balance_minor")
  context              Json?
  actorUserId          String?                 @map("actor_user_id")
  actorUser            User?                   @relation("BillingTransitionActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime                @default(now()) @map("created_at")

  @@map("billing_transition_history")
  @@index([invoiceId, createdAt], map: "idx_billing_transition_history_invoice_created_at")
  @@index([transitionType], map: "idx_billing_transition_history_transition_type")
  @@index([actorUserId], map: "idx_billing_transition_history_actor_user_id")
}

model BillingChargeIdempotency {
  id              String             @id @default(cuid())
  invoiceId       String             @map("invoice_id")
  invoice         BillingInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineId          String             @unique @map("line_id")
  line            BillingInvoiceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  idempotencyKey  String             @map("idempotency_key")
  requestHash     String             @map("request_hash")
  createdByUserId String?            @map("created_by_user_id")
  createdByUser   User?              @relation("BillingChargeReplayCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now()) @map("created_at")

  @@map("billing_charge_idempotency")
  @@unique([invoiceId, idempotencyKey], map: "uq_billing_charge_idempotency_invoice_key")
  @@index([createdByUserId], map: "idx_billing_charge_idempotency_created_by_user_id")
}
