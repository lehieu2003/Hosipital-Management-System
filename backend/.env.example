# App
APP_NAME=Hospital Management System API
API_V1_PREFIX=/api/v1

# JWT
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=hospital-backend
JWT_ACCESS_AUDIENCE=hospital-api

# Refresh cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_HTTPONLY=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=hospital_management
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_CONNECT_TIMEOUT_SECONDS=5
DB_REQUIRE_ON_STARTUP=true
