# Backend runtime env file uploaded by GitHub Actions as BACKEND_ENV_FILE.
# These values are consumed by the backend container on EC2.
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-frontend-project.vercel.app
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
DATABASE_URL=postgresql://postgres:postgres@your-postgres-host:5432/hms

# CI/CD workflow secrets required in GitHub Actions.
# Do not place these four SSH/GHCR values inside backend.env on EC2.
# Store them as GitHub Actions secrets instead.
GHCR_TOKEN=github_pat_xxx
AWS_EC2_SSH_HOST=ec2-your-host.amazonaws.com
AWS_EC2_SSH_PORT=22
AWS_EC2_SSH_USER=ubuntu
AWS_EC2_SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
BACKEND_ENV_FILE=<paste the runtime env block above as one multiline GitHub secret>
